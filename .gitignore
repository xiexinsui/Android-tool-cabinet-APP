# ===== 编译产物与构建缓存 =====
build/
.gradle/
.cxx/
.externalNativeBuild/
captures/
*.iml
*.apk
*.aab
*.ap_
*.dex
*.class
lint-results*
release/
debug/

# ===== IDE 与工具元数据 =====
.idea/
.DS_Store
Thumbs.db
desktop.ini
.kotlin/
*.swp
*~

# 本机 SDK 路径，换机器要重新生成，且含个人目录信息
local.properties

# ===== 本机调试遗留（非源码，体积大）=====
# Android Studio Python 插件在本工程目录下落的解释器缓存
/Python/
# 真机截图、临时校验产物
/_verify/
*.log

# ===== 签名与凭据：任何情况下都不入库 =====
# release 密钥与它的口令文件整目录排除（signing.properties 里是明文口令，
# 而 *.properties 本身不在排除范围，所以按目录挡，别指望 *.jks 那几条）
/keystore/
*.jks
*.keystore
*.p12
*.pfx
*.pem
.env
secrets*
*token*
*.rmi
passwords*

# 内置远程桌面的原生层：FreeRDP/OpenSSL 源码与交叉编译产物（按需重编，见 third_party/README.md）
/third_party/freerdp/
/third_party/openssl-*/
/third_party/build/
/third_party/prebuilt/
/third_party/*.tar.gz
# CPAN 原始包：里面的模块已整理进 third_party/perl-lib（构建脚本按 perl-lib 检查，那份才入库）
/third_party/ExtUtils-MakeMaker-7.70/
# AGP 的 native 构建中间目录（已在 build/ 之外单独落一份）
/app/.cxx/
# 1.x 时代自写 RDP shim 的编译产物：源码线（RdpNative / rdpcore / librdpcore.so）已删，产物留在本机备查
/build-shim/

# 说明：gradle/wrapper/gradle-wrapper.jar 属于构建必需文件，不在排除范围内。

