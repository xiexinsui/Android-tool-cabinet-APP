<?xml version="1.0" encoding="utf-8"?>
<!--
  功能键面板。修饰键做成 ToggleButton 而不是"按住不放"：手机上没法一只手按住 Ctrl、
  另一只手去点屏幕上的 C，所以改成按下即锁存、再点一次或关面板才松开。

  外面套一层 ScrollView：横屏时机身高度只剩一半，6 行按键放不下会被直接截掉。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingTop="4dp"
        android:paddingRight="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ToggleButton
                android:id="@+id/tb_rdp_ctrl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:textOff="Ctrl"
                android:textOn="Ctrl"
                android:textSize="12sp" />

            <ToggleButton
                android:id="@+id/tb_rdp_alt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:textOff="Alt"
                android:textOn="Alt"
                android:textSize="12sp" />

            <ToggleButton
                android:id="@+id/tb_rdp_shift"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:textOff="Shift"
                android:textOn="Shift"
                android:textSize="12sp" />

            <ToggleButton
                android:id="@+id/tb_rdp_win"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:textOff="Win"
                android:textOn="Win"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_rdp_cad"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/rdp_keys_cad" />

        <!-- 键位由 RdpKeys.FUNCTION_KEYS 填进来，列数固定 5，与那里的表一一对应 -->
        <GridLayout
            android:id="@+id/gl_rdp_keys"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="5" />
    </LinearLayout>
</ScrollView>
