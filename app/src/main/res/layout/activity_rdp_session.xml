<?xml version="1.0" encoding="utf-8"?>
<!--
  会话页的控件层。
  参照微软 Windows App 的做法：桌面铺满整个屏幕，控件浮在画面上而不是占掉一行高度——
  手机上纵向空间本来就紧，一条常驻工具栏能吃掉十分之一的桌面。

  顶部是一条半透明胶囊：收起时只剩一个「☰」，点开才展开全部按钮与状态行。
  鼠标模式另有一条浮在底部的按键行（左/右/中/滚轮），只在鼠标模式下出现。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fl_rdp_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <SurfaceView
        android:id="@+id/sv_rdp"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 只用来唤起软键盘并接收输入，视觉上不可见但必须可获得焦点；
         contentDescription 是给无障碍服务的，否则这块输入口在 TalkBack 里完全没有名字 -->
    <EditText
        android:id="@+id/et_rdp_input"
        android:layout_width="2dp"
        android:layout_height="2dp"
        android:alpha="0"
        android:autofillHints="none"
        android:contentDescription="@string/rdp_input_ime_hint"
        android:importantForAutofill="no"
        android:inputType="textNoSuggestions"
        android:textColor="#00000000" />

    <!-- 鼠标模式的触摸板提示：不画出来的话，用户只会觉得"点了没反应" -->
    <TextView
        android:id="@+id/tv_rdp_pad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="72dp"
        android:background="#66000000"
        android:paddingLeft="8dp"
        android:paddingTop="3dp"
        android:paddingRight="8dp"
        android:paddingBottom="3dp"
        android:text="@string/rdp_pad_hint"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="#FFEEEEEE"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/ll_rdp_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_rdp_bar"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingLeft="6dp"
        android:paddingTop="4dp"
        android:paddingRight="6dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tv_rdp_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingBottom="2dp"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="#FFDDDDDD"
            android:visibility="gone" />

        <!-- 按钮多到 9 个，窄屏放不下：横向滚动兜底，不至于把「断开」挤出屏幕 -->
        <HorizontalScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

            <Button
                android:id="@+id/btn_rdp_bar_toggle"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/rdp_bar_expand"
                android:minWidth="44dp"
                android:text="@string/rdp_bar_handle" />

            <Button
                android:id="@+id/tb_rdp_mode"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/rdp_mode_touch" />

            <Button
                android:id="@+id/btn_rdp_keyboard"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/rdp_btn_keyboard" />

            <Button
                android:id="@+id/btn_rdp_pan"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/rdp_btn_pan" />

            <Button
                android:id="@+id/btn_rdp_orient"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/rdp_btn_landscape" />

            <Button
                android:id="@+id/btn_rdp_fullscreen"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/rdp_btn_fullscreen" />

            <Button
                android:id="@+id/btn_rdp_functions"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/rdp_btn_functions" />

            <Button
                android:id="@+id/btn_rdp_display"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/rdp_btn_display" />

            <Button
                android:id="@+id/btn_rdp_disconnect"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/rdp_btn_disconnect" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

</FrameLayout>
