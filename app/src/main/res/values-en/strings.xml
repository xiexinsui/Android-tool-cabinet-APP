        <item>2 RTS low + DTR low (BOOT0) + RTS high</item>
        <item>3 RTS high + DTR high (BOOT0) + RTS low</item>
        <item>4 RTS low + DTR high (BOOT0) + RTS high</item>
        <item>5 DTR high + RTS low (BOOT0) + DTR low</item>
        <item>6 DTR low + RTS low (BOOT0) + DTR high</item>
        <item>7 DTR high + RTS high (BOOT0) + DTR low</item>
        <item>8 DTR low + RTS high (BOOT0) + DTR high</item>
        <item>9 DTR low→high reset pulse (no RTS)</item>
        <item>10 DTR high→low reset pulse (no RTS)</item>
        <item>11 RTS low→high reset pulse (no DTR)</item>
        <item>12 RTS high→low reset pulse (no DTR)</item>
        <item>13 Keep DTR low (BOOT0, no RTS)</item>
        <item>14 Keep DTR high (BOOT0, no RTS)</item>
        <item>15 Keep RTS low (BOOT0, no DTR)</item>
        <item>16 Keep RTS high (BOOT0, no DTR)</item>
    </string-array>

